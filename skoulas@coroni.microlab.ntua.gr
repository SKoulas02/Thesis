# ----------------------------------------------------------------------------
# 450 MHz kernel clock (2.222 ns).  NOTE: the old "400Mhz" comment was wrong --
# 1 / 2.222 ns = 450 MHz.  The period is unchanged, so results stay comparable
# to the banked numbers in Utilization.xlsx.
#
# The clock PORT NAME depends on which module is the top:
#   dense_gemv       -> clk      (the bare verified engine)
#   dense_gemv_axis  -> ap_clk   (the AXIS wrapper; the Vitis RTL Kernel Wizard
#                                 fixes ap_clk / ap_rst_n on the kernel top, so
#                                 this rename is required and permanent)
#
# Constraining the wrong name is NOT an error -- create_clock on an empty
# object list only warns, and the run completes reporting WNS = inf with every
# endpoint unconstrained.  That looks like a pass and is not one.  Hence the
# explicit selection below, and the hard error if neither port exists.
# ----------------------------------------------------------------------------

if {[llength [get_ports -quiet clk]]} {
    create_clock -period 2.222 -name clk [get_ports clk]
} elseif {[llength [get_ports -quiet ap_clk]]} {
    create_clock -period 2.222 -name ap_clk [get_ports ap_clk]
} else {
    error "timing.xdc: no clock port found (looked for 'clk' and 'ap_clk'). Check the top module."
}
